# O Git guarda LF no repositório. Na cópia de trabalho, o código e a
# configuração ficam em LF também no Windows: é o que o FlatCap escreve
# (`newline="\n"`) e o que o diff compara. Os outros textos seguem o sistema.
* text=auto

*.py      text eol=lf diff=python
*.md      text eol=lf diff=markdown
*.toml    text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.cff     text eol=lf
*.txt     text eol=lf
*.in      text eol=lf
*.csv     text eol=lf
.env.example   text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
LICENSE        text eol=lf

# Scripts: os de shell em LF; os do Windows em CRLF.
*.sh      text eol=lf
*.ps1     text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Os fixtures dos testes reproduzem o arquivo como ele chega — um .csv do
# Excel vem em CRLF e cp1252 —, e o Git não pode normalizá-los: se o fizesse,
# o teste passaria a testar outro arquivo sem falhar.
tests/fixtures/** -text

# Binários: o fim de linha nunca é tocado, e o diff não é de texto.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.docx    binary
*.xlsx    binary
*.xls     binary
*.zip     binary
*.gz      binary
*.whl     binary

# Fora do código-fonte que o GitHub empacota em cada versão (git archive):
# a configuração das ferramentas do repositório.
.github/**              export-ignore
.pre-commit-config.yaml export-ignore
